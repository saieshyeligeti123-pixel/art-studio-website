# ==============================================================================
# Art Studio Website (Atelier Terre & Toile) - Environment Configuration
# ==============================================================================

# Port to run the server on (default: 3000)
PORT=3000

# JSON Web Token secret key for session authentication and RBAC
JWT_SECRET="replace-with-your-own-random-secret"

# SQLite local database storage path (relative to workspace root)
DATABASE_PATH="data/artstudio.db"

# GEMINI_API_KEY: Required for Gemini AI API calls (if invoked)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
